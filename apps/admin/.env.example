# Copia a .env.local y completa con tu proyecto Supabase.
# Nunca subas .env.local al repo ni pegues service_role en el frontend.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# C6.1 — solo servidor (Vercel env + .env.local). Nunca NEXT_PUBLIC_.
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
